---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { assertLang } from '../../../lib/content';
import { allAlbums, type AlbumEntry } from '../../../lib/site-content';
import { isoDate, readableDate } from '../../../lib/format';

interface Props {
  entry: AlbumEntry;
}

export async function getStaticPaths() {
  const entries = await allAlbums();
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.data.slug },
    props: { entry },
  }));
}

const lang = assertLang(Astro.params.lang);
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const data = entry.data;
const title = data.title;
const label = {
  back: lang === 'zh' ? '返回相册' : 'Back to albums',
  open: lang === 'zh' ? '打开大图' : 'Open full image',
  close: lang === 'zh' ? '关闭大图' : 'Close image',
  previous: lang === 'zh' ? '上一张' : 'Previous image',
  next: lang === 'zh' ? '下一张' : 'Next image',
  images: lang === 'zh' ? '张图片' : 'images',
};
const firstImage = data.images[0]!;
---

<BaseLayout lang={lang} title={title} ogType="article">
  <main id="main" class="page">
    <div class="sheet sheet--ruled">
      <aside class="margin" aria-label={lang === 'zh' ? '相册索引' : 'Album index'}>
        <a href={`/${lang}/albums/`} class="back">← {label.back}</a>
        <p class="mono">{data.images.length} {label.images}</p>
      </aside>

      <article class="content paper-surface" data-album-lightbox>
        <header class="heading">
          <p class="eyebrow">{lang === 'zh' ? '主题相册' : 'THEMED ALBUM'}</p>
          <h1>{data.title}</h1>
          <p class="description">{data.description}</p>
          <time class="seal" datetime={isoDate(data.date)}>{readableDate(data.date, lang)}</time>
        </header>

        <div class="prose"><Content /></div>

        <section class="gallery" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading">{lang === 'zh' ? '图像' : 'Images'}</h2>
          <div class="image-grid">
            {data.images.map((image, index) => (
              <figure>
                <button
                  type="button"
                  class="image-button"
                  data-lightbox-trigger
                  data-index={index}
                  aria-haspopup="dialog"
                  aria-controls="album-lightbox"
                  aria-label={`${label.open}: ${image.alt}`}
                >
                  <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} />
                </button>
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>

        <dialog id="album-lightbox" aria-labelledby="lightbox-title">
          <div class="dialog-inner">
            <header class="dialog-heading">
              <h2 id="lightbox-title">{data.title}</h2>
              <button type="button" class="close-button" data-lightbox-close>{label.close}</button>
            </header>
            <div class="dialog-stage">
              <button type="button" class="arrow-button" data-lightbox-prev aria-label={label.previous}>←</button>
              <figure>
                <img data-lightbox-image src={firstImage.src} alt={firstImage.alt} />
                <figcaption data-lightbox-caption>{firstImage.caption ?? ''}</figcaption>
              </figure>
              <button type="button" class="arrow-button" data-lightbox-next aria-label={label.next}>→</button>
            </div>
          </div>
        </dialog>
      </article>
    </div>
  </main>
</BaseLayout>

<script>
  function setupAlbumLightbox(): void {
    const root = document.querySelector<HTMLElement>('[data-album-lightbox]');
    if (!root || root.dataset.lightboxReady === 'true') return;
    root.dataset.lightboxReady = 'true';

    const dialog = root.querySelector<HTMLDialogElement>('#album-lightbox');
    const image = root.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = root.querySelector<HTMLElement>('[data-lightbox-caption]');
    const close = root.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const previous = root.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
    if (!dialog || !image || !caption || !close || !previous || !next || triggers.length === 0) return;
    // TypeScript does not preserve DOM-query narrowing inside nested callbacks.
    // Stable aliases make the lifecycle explicit and keep every callback typed.
    const dialogEl = dialog;
    const imageEl = image;
    const captionEl = caption;
    const closeButton = close;

    let current = 0;
    let lastTrigger: HTMLButtonElement | null = null;

    function update(index: number): void {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      if (!trigger) return;
      const source = trigger.querySelector<HTMLImageElement>('img');
      if (!source) return;
      imageEl.src = source.currentSrc || source.src;
      imageEl.alt = source.alt;
      captionEl.textContent = trigger.closest('figure')?.querySelector<HTMLElement>('figcaption')?.textContent || '';
    }

    function restoreFocus(): void {
      if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
      lastTrigger = null;
    }

    function closeDialog(): void {
      if (typeof dialogEl.close === 'function' && dialogEl.open) {
        dialogEl.close();
      } else {
        dialogEl.removeAttribute('open');
        restoreFocus();
      }
    }

    function openDialog(index: number, trigger: HTMLButtonElement): void {
      lastTrigger = trigger;
      update(index);
      if (typeof dialogEl.showModal === 'function') {
        if (!dialogEl.open) dialogEl.showModal();
      } else {
        dialogEl.setAttribute('open', '');
      }
      closeButton.focus();
    }

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => openDialog(index, trigger));
    });
    closeButton.addEventListener('click', closeDialog);
    previous.addEventListener('click', () => update(current - 1));
    next.addEventListener('click', () => update(current + 1));
    dialogEl.addEventListener('close', restoreFocus);
    dialogEl.addEventListener('cancel', (event: Event) => {
      event.preventDefault();
      closeDialog();
    });
    dialogEl.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        update(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        update(current + 1);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        closeDialog();
      }
    });
    dialogEl.addEventListener('click', (event: MouseEvent) => {
      if (event.target === dialogEl) closeDialog();
    });
  }

  setupAlbumLightbox();
  document.addEventListener('astro:page-load', setupAlbumLightbox);
</script>

<style>
  .content {
    padding: var(--s2);
  }

  .back {
    color: var(--ink-faded);
    font-size: var(--fs-sm);
  }

  .heading {
    padding-bottom: var(--s2);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    margin-block: 0.4rem;
    font-size: var(--fs-display);
    line-height: var(--lh-heading);
  }

  .description {
    max-width: 52ch;
    color: var(--ink-faded);
    font-size: var(--fs-lg);
  }

  .prose {
    max-width: 64ch;
    margin-top: var(--s2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-block: 0.9em;
  }

  .gallery {
    margin-top: var(--s3);
    padding-top: var(--s1);
    border-top: 1px solid var(--rule);
  }

  .gallery h2 {
    margin: 0 0 var(--s1);
    font-size: var(--fs-h2);
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s1);
  }

  figure {
    margin: 0;
  }

  .image-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: inherit;
    cursor: zoom-in;
  }

  .image-button:hover,
  .image-button:focus-visible {
    border-color: var(--stamp);
  }

  .image-button img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.35rem;
    color: var(--pencil);
    font-size: var(--fs-xs);
  }

  dialog {
    width: min(92vw, 58rem);
    max-width: none;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    color: var(--ink);
  }

  dialog::backdrop {
    background: rgba(19, 27, 37, 0.72);
  }

  .dialog-inner {
    padding: var(--s1);
  }

  .dialog-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s1);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.65rem;
  }

  .dialog-heading h2 {
    margin: 0;
    font-size: var(--fs-h3);
  }

  .close-button,
  .arrow-button {
    border: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  .close-button {
    padding: 0.25rem 0.5rem;
    font-size: var(--fs-sm);
  }

  .arrow-button {
    width: 2.5rem;
    min-height: 2.5rem;
    font-size: 1.35rem;
  }

  .arrow-button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .dialog-stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s1);
    padding-top: var(--s1);
  }

  .dialog-stage figure {
    min-width: 0;
  }

  .dialog-stage img {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    background: var(--paper);
  }

  .dialog-stage figcaption {
    min-height: 1.2em;
  }

  @media (max-width: 42rem) {
    .content {
      padding: var(--s1);
    }

    h1 {
      font-size: var(--fs-h1);
    }
  }

  @media (max-width: 34rem) {
    .image-grid {
      grid-template-columns: 1fr;
    }

    .dialog-stage {
      grid-template-columns: 1fr 1fr;
    }

    .dialog-stage figure {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .arrow-button[data-lightbox-prev] {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }

    .arrow-button[data-lightbox-next] {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }
  }
</style>
