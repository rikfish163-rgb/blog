---
import BaseLayout from '../../layouts/BaseLayout.astro';
import aiIndex from '../../generated/ai-index.json';
import { langPaths, assertLang } from '../../lib/content';
import { useT } from '../../i18n/ui';
import type { Locale } from '../../site.config';

/**
 * 搜索页。
 *
 * 现在只有 Pagefind 全文搜索。阶段 5 会在这里加「问 AI」那一条 ——
 * 结构上已经预留：结果区上方留了 [data-ai-slot]，AI 回答插进去即可，
 * 不必重排整个页面。
 *
 * Pagefind 的索引只在 astro build 后存在，dev 下会 404 —— 这是正常的，
 * 下面对加载失败做了显式提示，而不是让输入框一直无响应。
 */
export function getStaticPaths() {
  return langPaths();
}

const lang = assertLang(Astro.params.lang);
const t = useT(lang as Locale);
const authAiVisible = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_AUTH_AI === 'true';
const fallbackIndex = aiIndex.chunks
  .filter((chunk) => chunk.lang === lang)
  .map(({ title, url, text }) => ({ title, url, text }));
---

<BaseLayout lang={lang} title={t('nav.search')} current="search">
  <main id="main" class="page">
    <div class="sheet">
      <aside class="margin">
        <p class="hint mono" data-count></p>
      </aside>

      <div class="content">
        <h1 class="title">{t('nav.search')}</h1>

        <form class="search" role="search" onsubmit="return false">
          <input
            type="search"
            id="q"
            class="input"
            placeholder={t('search.placeholder')}
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            maxlength="1000"
            data-search-input
            aria-describedby="search-status"
          />
          {authAiVisible && <button type="button" class="ai-button" data-ai-ask>{lang === 'zh' ? '问 AI' : 'Ask AI'}</button>}
        </form>

        {
          authAiVisible && (
            <div class="ai-panel" data-ai-slot>
              <p class="status" data-ai-status role="status" aria-live="polite"></p>
              <p class="ai-login" data-ai-login hidden>
                {lang === 'zh' ? '请先登录：' : 'Sign in first:'}
                <a href={`/${lang}/account/`}>GitHub</a>
                <a href={`/${lang}/account/`}>Google</a>
                <a href={`/${lang}/account/`}>Linux DO</a>
              </p>
              <p class="ai-config" data-ai-config hidden>
                {lang === 'zh' ? 'AI 问答尚未配置，普通搜索仍可用。' : 'AI Q&A is not configured; ordinary search remains available.'}
              </p>
              <div class="ai-history" data-ai-history></div>
            </div>
          )
        }

        {/* 状态用 aria-live 播报，读屏用户才知道结果变了 */}
        <p id="search-status" class="status" role="status" aria-live="polite"></p>

        <ul class="results" data-results></ul>
      </div>
    </div>
  </main>

<script is:inline define:vars={{ fallbackIndex, strings: {
  results: t('search.results', { n: '{n}' }),
  noResults: t('search.noResults'),
  unavailable: lang === 'zh'
    ? '搜索索引尚未生成。索引在 astro build 时产出，本地开发用 pnpm build && pnpm preview 查看。'
    : 'Search index not built yet. It is generated by astro build — use pnpm build && pnpm preview locally.',
  confirm: lang === 'zh'
    ? '本次问 AI 会消耗你的额度，确认继续吗？'
    : 'This AI question consumes your quota. Continue?',
  waiting: lang === 'zh' ? '正在等待 AI 回答……' : 'Waiting for the AI answer…',
  empty: lang === 'zh' ? '请输入问题。' : 'Enter a question first.',
  tooLong: lang === 'zh' ? '问题最多 1000 字。' : 'Questions are limited to 1000 characters.',
  failed: lang === 'zh' ? 'AI 暂时不可用，普通搜索仍可用。' : 'AI is temporarily unavailable; ordinary search remains available.',
  login: lang === 'zh' ? '请先登录后再问 AI。' : 'Please sign in before asking the AI.',
  config: lang === 'zh'
    ? 'AI 问答尚未配置，普通搜索仍可用。'
    : 'AI Q&A is not configured; ordinary search remains available.',
} }}>
  {
    /** @type {Window & { __searchInit?: boolean }} */
    const searchWindow = window;
    if (!searchWindow.__searchInit) {
      // 全局守卫 + document 级委托，跨 SPA 导航只初始化一次
      searchWindow.__searchInit = true;

      /**
       * @typedef {{
       *   url: string,
       *   excerpt?: string,
       *   meta?: { title?: string }
       * }} PagefindData
       * @typedef {{
       *   data: () => Promise<PagefindData>
       * }} PagefindResult
       * @typedef {{
       *   results: PagefindResult[]
       * }} PagefindSearchResponse
       * @typedef {{
       *   options: (options: { bundlePath: string, excerptLength: number }) => Promise<void>,
       *   init: () => Promise<void>,
       * }} PagefindApi
       */

      /** @type {PagefindApi | null} */
      let pagefind = null;
      let loadFailed = false;
      /** @type {Promise<PagefindApi> | null} */
      let pagefindPromise = null;
      let seq = 0;

      function els() {
        const input = /** @type {HTMLInputElement | null} */ (
          document.querySelector('[data-search-input]')
        );
        const list = /** @type {HTMLUListElement | null} */ (
          document.querySelector('[data-results]')
        );
        const status = document.getElementById('search-status');
        const count = /** @type {HTMLElement | null} */ (document.querySelector('[data-count]'));
        return { input, list, status, count };
      }

      /** @template T @param {Promise<T>} promise @param {number} milliseconds @returns {Promise<T>} */
      async function withTimeout(promise, milliseconds) {
        /** @type {number | undefined} */
        let timeout;
        try {
          return await Promise.race([
            promise,
            new Promise((_, reject) => {
              timeout = window.setTimeout(() => reject(new Error('Pagefind timed out')), milliseconds);
            }),
          ]);
        } finally {
          if (timeout !== undefined) window.clearTimeout(timeout);
        }
      }

      /** @param {string} version @returns {Promise<PagefindApi>} */
      async function initializePagefind(version) {
        // Warming the worker avoids a first-load race in Pagefind 1.5.x where
        // init can wait forever while the worker script is still cold.
        await fetch('/pagefind/pagefind-worker.js', { credentials: 'same-origin' });
        const url = `/pagefind/pagefind.js?v=${version}`;
        const loaded = /** @type {PagefindApi} */ (await import(/* @vite-ignore */ url));
        await loaded.options({ bundlePath: '/pagefind/', excerptLength: 24 });
        await withTimeout(loaded.init(), 4_000);
        return loaded;
      }

      /** @returns {Promise<PagefindApi | null>} */
      async function ensurePagefind() {
        if (pagefind) return pagefind;
        if (loadFailed) return null;
        pagefindPromise ??= initializePagefind('1.5.2').catch(() => initializePagefind('1.5.2-retry'));
        try {
          pagefind = await pagefindPromise;
          return pagefind;
        } catch {
          loadFailed = true;
          pagefindPromise = null;
          return null;
        }
      }

      /** @param {unknown} value */
      function esc(value) {
        const element = document.createElement('div');
        element.textContent = value == null ? '' : String(value);
        return element.innerHTML;
      }
      /** @param {string} query @param {HTMLUListElement} list @param {HTMLElement | null} status @param {HTMLElement | null} count */
      function renderFallback(query, list, status, count) {
        const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
        const seen = new Set();
        const matches = fallbackIndex.filter((item) => {
          if (seen.has(item.url)) return false;
          const haystack = `${item.title}\n${item.text}`.toLocaleLowerCase();
          if (!terms.every((term) => haystack.includes(term))) return false;
          seen.add(item.url);
          return true;
        }).slice(0, 20);
        list.innerHTML = matches.map((item) => {
          const excerpt = item.text.replace(/\s+/g, ' ').slice(0, 150);
          return '<li class="result">' +
            '<a class="r-title" href="' + esc(item.url) + '">' + esc(item.title) + '</a>' +
            '<p class="r-excerpt">' + esc(excerpt) + '</p>' +
            '</li>';
        }).join('');
        if (status) status.textContent = matches.length
          ? strings.results.replace('{n}', String(matches.length))
          : strings.noResults;
        if (count) count.textContent = String(matches.length);
      }


      /** @param {string} query */
      async function run(query) {
        const { input, list, status, count } = els();
        if (!input || !list) return;

        const mine = ++seq;
        query = query.trim();

        if (!query) {
          list.innerHTML = '';
          if (status) status.textContent = '';
          if (count) count.textContent = '';
          return;
        }

        const pf = await ensurePagefind();
        if (mine !== seq) return; // 输入已经变了，丢弃这次结果

        if (!pf) {
          renderFallback(query, list, status, count);
          return;
        }

        /** @type {PagefindSearchResponse} */
        let res;
        try {
          res = await withTimeout(pf.search(query), 1_500);
        } catch {
          // A cold Pagefind worker can miss its first handshake. A fresh module
          // instance reuses the now-cached worker script and recovers once.
          pagefind = null;
          pagefindPromise = initializePagefind('1.5.2-search-retry');
          try {
            pagefind = await pagefindPromise;
            res = await withTimeout(pagefind.search(query), 1_500);
          } catch {
            loadFailed = true;
            pagefindPromise = null;
            renderFallback(query, list, status, count);
            return;
          }
        }
        if (mine !== seq) return;

        const top = await Promise.all(res.results.slice(0, 20).map((result) => result.data()));
        if (mine !== seq) return;

        if (top.length === 0) {
          list.innerHTML = '';
          if (status) status.textContent = strings.noResults;
          if (count) count.textContent = '0';
          return;
        }

        if (status) status.textContent = strings.results.replace('{n}', String(res.results.length));
        if (count) count.textContent = String(res.results.length);

        list.innerHTML = top
          .map((data) => {
            return (
              '<li class="result">' +
              '<a class="r-title" href="' + esc(data.url) + '">' +
              esc(data.meta && data.meta.title ? data.meta.title : data.url) +
              '</a>' +
              '<p class="r-excerpt">' +
              (data.excerpt || '') +
              '</p>' +
              '</li>'
            );
          })
          .join('');
      }

      /** Keep AI history in this page instance only; it is intentionally not persisted. */
      const aiHistory = [];

      function aiEls() {
        return {
          button: /** @type {HTMLButtonElement | null} */ (document.querySelector('[data-ai-ask]')),
          status: /** @type {HTMLElement | null} */ (document.querySelector('[data-ai-status]')),
          login: /** @type {HTMLElement | null} */ (document.querySelector('[data-ai-login]')),
          config: /** @type {HTMLElement | null} */ (document.querySelector('[data-ai-config]')),
          history: /** @type {HTMLElement | null} */ (document.querySelector('[data-ai-history]')),
        };
      }

      function renderAiHistory() {
        const { history } = aiEls();
        if (!history) return;
        history.innerHTML = aiHistory
          .map((item) => {
            const sourceList = item.sources
              .map((source) => '<a href="' + esc(source.url) + '">' + esc(source.title) + '</a>')
              .join(' · ');
            return (
              '<article class="ai-entry">' +
              '<p class="ai-question">' + esc(item.question) + '</p>' +
              '<p class="ai-answer">' + esc(item.answer) + '</p>' +
              (sourceList ? '<p class="ai-sources">来源：' + sourceList + '</p>' : '') +
              '</article>'
            );
          })
          .join('');
      }

      async function askAi() {
        const { input } = els();
        const { button, status, login, config } = aiEls();
        if (!input || !status) return;
        const question = input.value.trim();
        if (!question) {
          status.textContent = strings.empty;
          return;
        }
        if (question.length > 1000) {
          status.textContent = strings.tooLong;
          return;
        }

        // A click always leaves ordinary Pagefind search available and up to date.
        await run(question);
        if (!window.confirm(strings.confirm)) return;

        if (button) button.disabled = true;
        if (login) login.hidden = true;
        if (config) config.hidden = true;
        status.textContent = strings.waiting;
        try {
          const response = await fetch('/api/ai/chat', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ lang: document.documentElement.lang.startsWith('en') ? 'en' : 'zh', input: question }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            const message = payload && typeof payload.error === 'string' ? payload.error : strings.failed;
            if (response.status === 401) {
              if (login) login.hidden = false;
              status.textContent = strings.login;
            } else if (response.status === 503 && /not configured|not publicly ready/i.test(message)) {
              if (config) {
                config.hidden = false;
                config.textContent = strings.config;
              }
              status.textContent = strings.config;
            } else {
              status.textContent = message;
            }
            return;
          }
          if (!payload || typeof payload.answer !== 'string') {
            status.textContent = strings.failed;
            return;
          }
          aiHistory.push({
            question,
            answer: payload.answer,
            sources: Array.isArray(payload.sources)
              ? payload.sources.filter(
                  (source) =>
                    source &&
                    typeof source.title === 'string' &&
                    typeof source.url === 'string',
                )
              : [],
          });
          renderAiHistory();
          status.textContent = '';
        } catch {
          status.textContent = strings.failed;
        } finally {
          if (button) button.disabled = false;
        }
      }

      let timer = 0;
      function bindSearchControls() {
        const { input } = els();
        const { button } = aiEls();
        if (input && input.dataset.searchBound !== 'true') {
          input.dataset.searchBound = 'true';
          input.addEventListener('input', () => {
            window.clearTimeout(timer);
            // 200ms 防抖：中文输入法组字过程中会连续触发 input
            timer = window.setTimeout(() => run(input.value), 200);
          });
        }
        if (button && button.dataset.aiBound !== 'true') {
          button.dataset.aiBound = 'true';
          button.addEventListener('click', () => {
            void askAi();
          });
        }
        if (input) input.focus();
      }

      document.addEventListener('astro:before-preparation', () => {
        aiHistory.length = 0;
      });
      document.addEventListener('astro:page-load', bindSearchControls);
      bindSearchControls();
    }
  }
</script>
</BaseLayout>

<style>
  .title {
    font-size: var(--fs-h1);
    padding-block: var(--s1) var(--s1);
  }

  .search {
    display: flex;
    align-items: end;
    gap: var(--s-1, 0.75rem);
    margin-bottom: var(--s1);
  }

  .search .input {
    flex: 1;
  }

  .ai-button {
    flex: 0 0 auto;
    border: 1px solid var(--stamp);
    color: var(--stamp);
    background: transparent;
    padding: 0.5rem 0.75rem;
    font: inherit;
    cursor: pointer;
  }

  .ai-button:hover,
  .ai-button:focus-visible {
    color: var(--paper);
    background: var(--stamp);
  }

  .ai-button:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .ai-panel {
    margin-bottom: var(--s1);
  }

  .ai-login,
  .ai-config {
    font-size: var(--fs-sm);
    color: var(--pencil);
  }

  .ai-login a {
    margin-inline-start: 0.5rem;
    color: var(--stamp);
  }

  .ai-entry {
    padding-block: var(--s1);
    border-bottom: 1px solid var(--rule);
  }

  .ai-question {
    color: var(--ink-strong);
    font-weight: 600;
  }

  .ai-answer {
    white-space: pre-wrap;
    line-height: 1.7;
  }

  .ai-sources {
    margin-top: 0.4rem;
    font-size: var(--fs-sm);
    color: var(--ink-faded);
  }

  .ai-sources a {
    color: var(--stamp);
  }

  /* 输入框做成一条横线，像在纸上划线填写，而不是一个圆角方框 */
  .input {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--pencil-light);
    padding: 0.5rem 0.1rem;
    border-radius: 0;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .input::placeholder {
    color: var(--pencil-light);
  }

  .input:focus {
    outline: none;
    border-bottom-color: var(--stamp);
  }

  .input:focus-visible {
    outline: none;
  }

  .status,
  .hint {
    font-size: var(--fs-sm);
    color: var(--pencil);
    min-height: 1.4em;
  }

  .results {
    list-style: none;
    margin: var(--s1) 0 0;
    padding: 0;
  }

  .results :global(.result) {
    padding-block: var(--s1);
    border-bottom: 1px solid var(--rule);
  }

  .results :global(.r-title) {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .results :global(.r-title:hover) {
    text-decoration: underline;
    text-decoration-color: var(--stamp);
  }

  .results :global(.r-excerpt) {
    margin-top: 0.3rem;
    font-size: var(--fs-sm);
    color: var(--ink-faded);
    line-height: 1.65;
  }

  /* Pagefind 用 <mark> 标命中词。用朱砂色下划线而不是黄色底色 */
  .results :global(mark) {
    background: none;
    color: var(--ink-strong);
    font-weight: 600;
    border-bottom: 1.5px solid var(--stamp);
  }
</style>
